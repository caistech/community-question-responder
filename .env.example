# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers (one is enough; OpenRouter recommended for cost) ---
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# default: anthropic/claude-sonnet-4.5 via OpenRouter, or claude-sonnet-4-5 direct
DRAFTER_MODEL=

# --- Embedding provider (for KB retrieval) ---
OPENAI_API_KEY=

# --- Slack user-token (NOT a bot token — read messages the user can see, post as the user) ---
# Generate via Slack OAuth: scopes channels:history, channels:read, chat:write, users:read
SLACK_USER_TOKEN=
SLACK_SIGNING_SECRET=

# --- Resend (for any product-side notifications, NOT Slack posts) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@updates.corporateaisolutions.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# --- @caistech package access (for shared services) ---
GITHUB_PACKAGES_TOKEN=
